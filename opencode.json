{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permissions": [
    { "action": "read", "resource": "**/*", "effect": "allow" },
    { "action": "read", "resource": ".env*", "effect": "deny" },
    { "action": "read", "resource": "**/.env*", "effect": "deny" },
    { "action": "read", "resource": ".dev.vars*", "effect": "deny" },
    { "action": "read", "resource": "**/.dev.vars*", "effect": "deny" },
    { "action": "read", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "read", "resource": "**/*service_role*", "effect": "deny" },
    { "action": "read", "resource": "**/*production*backup*", "effect": "deny" },
    { "action": "edit", "resource": "**/*", "effect": "ask" },
    { "action": "edit", "resource": ".env*", "effect": "deny" },
    { "action": "edit", "resource": "**/.env*", "effect": "deny" },
    { "action": "edit", "resource": ".dev.vars*", "effect": "deny" },
    { "action": "edit", "resource": "**/.dev.vars*", "effect": "deny" },
    { "action": "edit", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "edit", "resource": "**/*.pem", "effect": "deny" },
    { "action": "edit", "resource": "**/*.key", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git push origin opencode/*", "effect": "ask" },
    { "action": "shell", "resource": "git push origin opencode/* *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "deny" },
    { "action": "shell", "resource": "supabase *", "effect": "deny" },
    { "action": "shell", "resource": "vercel deploy --prod*", "effect": "deny" },
    { "action": "shell", "resource": "vercel --prod*", "effect": "deny" },
    { "action": "shell", "resource": "psql *", "effect": "deny" },
    { "action": "shell", "resource": "pg_dump *", "effect": "deny" },
    { "action": "shell", "resource": "pg_restore *", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "ask" }
  ]
}
