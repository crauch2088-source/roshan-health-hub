# Copy to .env.local (never commit real values). Names and placeholders only.

# Browser-safe: Supabase publishable (anon) key. Exposed to the client bundle by design.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Server-only: Supabase service-role / secret key. NEVER prefix with VITE_ (it would be bundled
# into the browser). Set it only in the server/hosting environment settings.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
