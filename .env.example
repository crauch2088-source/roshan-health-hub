# Copy to .env.local (never commit real values). Names and placeholders only.

# Browser-safe: Supabase publishable key (sb_publishable_...). Exposed to the client bundle by design.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Server-only: Supabase secret key (sb_secret_...). NEVER prefix with VITE_ (it would be bundled
# into the browser). Set it only in the server/hosting environment settings.
SUPABASE_SECRET_KEY=your-secret-key-here
